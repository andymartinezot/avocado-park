#!/bin/sh
# Runs QA on exactly what is being pushed, not on the working folder, so
# uncommitted files can't make a broken commit pass.
# Enable once per clone: git config core.hooksPath .githooks
set -u

zero=0000000000000000000000000000000000000000
checked=" "
while read -r _ sha _ _; do
  case "$sha$checked" in
    "$zero"*) continue ;; # deleting a ref
    *" $sha "*) continue ;; # already checked
  esac
  checked="$checked$sha "

  dir=$(mktemp -d) || exit 1
  trap 'rm -rf "$dir"' EXIT
  git archive "$sha" | tar -x -C "$dir" || exit 1
  echo "qa: checking $(git log -1 --format='%h %s' "$sha")"
  [ -x "$dir/scripts/qa.sh" ] || { echo "qa: scripts/qa.sh is missing from that commit" >&2; exit 1; }
  "$dir/scripts/qa.sh" || {
    echo "qa: push stopped; nothing was sent." >&2
    exit 1
  }
  rm -rf "$dir"
done
